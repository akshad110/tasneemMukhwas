# Server
PORT=5000
# On Render: do NOT set PORT in dashboard — Render assigns it automatically.
NODE_ENV=development

# MongoDB — paste your Atlas / local connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskeen_mukhwas?retryWrites=true&w=majority

# JWT — use a long random secret in production
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS — frontend origin(s), comma-separated for multiple
CLIENT_URL=http://localhost:5173
# Production example:
# CLIENT_URL=https://tasneemmukhwas.onrender.com
# Or: CORS_ORIGINS=https://tasneemmukhwas.onrender.com,https://tasneemmukhwas.com

# Admin account (used by npm run ensure-admin)
ADMIN_NAME=Admin Tasneem
ADMIN_EMAIL=akshavengurlekar35@gmail.com
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=+91 91043 01430

# Resend email (order alerts + discount campaigns)
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Tasneem Mukhwas <info@tasneemmukhwas.com>
# Fallback inbox when Resend test mode blocks non-verified recipients (use your Resend account email)
RESEND_SANDBOX_TO=akshavengurlekar35@gmail.com
